# Google AI Studio / Gemini API key (server-only; never expose to the client)
GEMINI_API_KEY=

# Optional: defaults to gemini-2.5-flash (stable)
# GEMINI_MODEL=gemini-2.5-flash

# Neon Postgres connection string (server-only)
DATABASE_URL=

# Neon Auth — enable in Neon Console → Auth → Configuration (copy Auth URL)
# Example: https://ep-xxx.neonauth.c-7.us-east-1.aws.neon.tech/neondb/auth
# If empty, the app derives this from DATABASE_URL when possible.
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Local http://localhost: cookies are renamed from __Secure-neon-auth.* to neon-auth.*
# (browsers reject __Secure- cookies without Secure). Production HTTPS keeps __Secure- names.

# Vercel Blob (comment images; server-only). Used by POST /api/upload and /api/blob/upload.
BLOB_READ_WRITE_TOKEN=
